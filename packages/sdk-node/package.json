{
  "name": "@bugbusterhq/sdk-node",
  "version": "0.1.0",
  "description": "The BugBuster instrumentation SDK — hot-path capture, client-side fingerprinting and folding, UDS/HTTP transport, and framework auto-instrumentation.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kunal-arora-1411/BugBuster.git",
    "directory": "packages/sdk-node"
  },
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "clean": "rimraf -g dist *.tsbuildinfo",
    "typecheck": "tsc -b",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run test/unit",
    "bench": "vitest bench test/bench --run"
  },
  "dependencies": {
    "@bugbusterhq/types": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
