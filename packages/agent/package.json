{
  "name": "@bugbuster/agent",
  "version": "0.1.0",
  "description": "The required host-local BugBuster daemon (v1) — cross-process fold merging, disk spool, and the only thing that makes the HTTPS hop to the backend.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bugbuster-agent": "./dist/index.js"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kunal-arora-1411/BugBuster.git",
    "directory": "packages/agent"
  },
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "clean": "rimraf -g dist *.tsbuildinfo",
    "typecheck": "tsc -b",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run test/unit"
  },
  "dependencies": {
    "@bugbuster/types": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
