{
  "openapi": "3.1.0",
  "info": {
    "title": "BugBuster API",
    "version": "1",
    "description": "Ingest and Query API of the BugBuster backend.\n\nEvery route except `/openapi.json`, `/docs` and the admin routes needs your organization's API key as `Authorization: Bearer <apiKey>`. The key decides which organization's database a request reads or writes — there is no way to address another organization's data. Admin routes take the backend's `BUGBUSTER_ADMIN_TOKEN` instead.\n\nYou normally never call `POST /ingest` yourself: the SDK (`@bugbusterhq/sdk-node`) or the Agent does. The `GET` routes are what the dashboard uses, and are safe to script against."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Issues",
      "description": "Folded errors: one issue per fingerprint."
    },
    {
      "name": "Logs",
      "description": "Application log lines, stored one by one."
    },
    {
      "name": "Ingest",
      "description": "Where the SDK and Agent send data."
    },
    {
      "name": "Admin",
      "description": "Operator-only: needs the backend's admin token."
    },
    {
      "name": "Meta",
      "description": "This API description."
    }
  ],
  "paths": {
    "/issues": {
      "get": {
        "tags": [
          "Issues"
        ],
        "operationId": "listIssues",
        "summary": "List issues, most recently seen first",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Issues per page. Values above 200 are capped at 200.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque token from a previous response's `nextCursor`. Omit for the first page. Never construct or parse it client-side.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of issues.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "issues"
                  ],
                  "properties": {
                    "issues": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Issue"
                      }
                    },
                    "nextCursor": {
                      "type": "string",
                      "description": "Present only when more issues remain."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The cursor is not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid cursor"
                }
              }
            }
          },
          "401": {
            "description": "Missing or unknown API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid api key"
                }
              }
            }
          }
        }
      }
    },
    "/issues/{fingerprint}": {
      "get": {
        "tags": [
          "Issues"
        ],
        "operationId": "getIssue",
        "summary": "Get one issue",
        "parameters": [
          {
            "name": "fingerprint",
            "in": "path",
            "required": true,
            "description": "The issue's fingerprint, as returned in `GET /issues`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The issue.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Issue"
                }
              }
            }
          },
          "401": {
            "description": "Missing or unknown API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid api key"
                }
              }
            }
          },
          "404": {
            "description": "No such fingerprint in your organization (also returned when it exists only in another organization).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "not found"
                }
              }
            }
          }
        }
      }
    },
    "/issues/{fingerprint}/exemplars": {
      "get": {
        "tags": [
          "Issues"
        ],
        "operationId": "getIssueExemplars",
        "summary": "Get an issue's full example events",
        "description": "The handful of complete events kept for an issue (first, last, slowest, one per release, one novel stack), in the order of the issue's `exemplarRefs`.",
        "parameters": [
          {
            "name": "fingerprint",
            "in": "path",
            "required": true,
            "description": "The issue's fingerprint, as returned in `GET /issues`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The example events.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "exemplars"
                  ],
                  "properties": {
                    "exemplars": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or unknown API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid api key"
                }
              }
            }
          },
          "404": {
            "description": "No such fingerprint in your organization.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "not found"
                }
              }
            }
          }
        }
      }
    },
    "/logs": {
      "get": {
        "tags": [
          "Logs"
        ],
        "operationId": "queryLogs",
        "summary": "Search log lines, newest first",
        "description": "All filters are optional and combine with AND. Paginate by passing `nextCursor` back as `cursor` with the same filters.",
        "parameters": [
          {
            "name": "level",
            "in": "query",
            "required": false,
            "description": "Comma-separated levels to include, e.g. `warn,error`.",
            "schema": {
              "type": "string",
              "example": "warn,error"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Case-insensitive substring of the message (first 200 characters used).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "service",
            "in": "query",
            "required": false,
            "description": "Exact service name (`service.name`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "environment",
            "in": "query",
            "required": false,
            "description": "Exact environment (`service.environment`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "traceId",
            "in": "query",
            "required": false,
            "description": "Only lines from this trace — everything one request logged.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Earliest timestamp, inclusive (ISO 8601).",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Latest timestamp, inclusive (ISO 8601). Must not be before `from`.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Lines per page. Values above 500 are capped at 500.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque token from a previous response's `nextCursor`. Omit for the first page. Never construct or parse it client-side.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of log lines.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "logs"
                  ],
                  "properties": {
                    "logs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LogEntry"
                      }
                    },
                    "nextCursor": {
                      "type": "string",
                      "description": "Present only when more lines remain."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "A filter is malformed (unknown level, unparseable date, `from` after `to`, bad cursor).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid level: fatal"
                }
              }
            }
          },
          "401": {
            "description": "Missing or unknown API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid api key"
                }
              }
            }
          }
        }
      }
    },
    "/logs/facets": {
      "get": {
        "tags": [
          "Logs"
        ],
        "operationId": "getLogFacets",
        "summary": "Distinct services and environments",
        "description": "For filter dropdowns. Cached per organization for up to 60 seconds, so a brand-new service can take a minute to appear.",
        "responses": {
          "200": {
            "description": "Sorted distinct values.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "services",
                    "environments"
                  ],
                  "properties": {
                    "services": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "environments": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or unknown API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid api key"
                }
              }
            }
          }
        }
      }
    },
    "/ingest": {
      "post": {
        "tags": [
          "Ingest"
        ],
        "operationId": "ingest",
        "summary": "Send a batch of telemetry (used by the SDK and Agent)",
        "description": "The body is NDJSON: one `EnvelopeItem` JSON object per line. Items of type `fold` and `exemplar` become issues, `log` items are stored as log lines (invalid ones are dropped individually), and `meta` items carry drop counters. Re-sending a batch is safe for logs (deduplicated by `logId`).\n\nThe response headers are backpressure directives the sender should obey.",
        "parameters": [
          {
            "name": "Content-Encoding",
            "in": "header",
            "required": false,
            "description": "`zstd` when the body is zstd-compressed (the Agent always compresses).",
            "schema": {
              "type": "string",
              "enum": [
                "zstd"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-ndjson": {
              "schema": {
                "type": "string",
                "description": "One `EnvelopeItem` per line."
              },
              "example": "{\"type\":\"log\",\"priority\":1,\"payload\":{\"logId\":\"01J9Z0000000000000000000AB\",\"timestamp\":\"2026-10-30T09:00:00.000Z\",\"level\":\"info\",\"message\":\"order placed\",\"fields\":{\"orderId\":\"o_1042\"},\"service\":{\"name\":\"orders-api\",\"version\":\"1.4.2\",\"environment\":\"production\"}}}\n"
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted.",
            "headers": {
              "X-BB-Sample-Directive": {
                "description": "Sample rates (0–1) the sender should apply per data type.",
                "schema": {
                  "type": "string",
                  "contentMediaType": "application/json"
                },
                "example": "{\"error\":1,\"log\":1,\"span\":1}"
              },
              "X-BB-Suppress-Fingerprints": {
                "description": "JSON array of fingerprints to send counts for but no examples.",
                "schema": {
                  "type": "string",
                  "contentMediaType": "application/json"
                },
                "example": "[]"
              },
              "X-BB-Config-Version": {
                "description": "Changes whenever the directives change.",
                "schema": {
                  "type": "string"
                }
              },
              "X-BB-Retry-After": {
                "description": "Seconds to wait before sending again. Only present when set.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing or unknown API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid api key"
                }
              }
            }
          },
          "413": {
            "description": "The body is larger than the backend's limit (2 MB by default)."
          }
        }
      }
    },
    "/admin/orgs": {
      "post": {
        "tags": [
          "Admin"
        ],
        "operationId": "createOrg",
        "summary": "Create an organization and its API key",
        "description": "Creates the organization (its data goes to its own database, `bugbuster_org_<orgId>`) and returns its new API key. **The key is shown only in this response**: only a hash is stored, so it can't be retrieved later.\n\nNeeds the backend's `BUGBUSTER_ADMIN_TOKEN` as the bearer token. When the backend has no admin token configured, this route answers `404`.",
        "security": [
          {
            "adminToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "orgId",
                  "name"
                ],
                "properties": {
                  "orgId": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$",
                    "description": "Permanent id; also names the org's database."
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              },
              "example": {
                "orgId": "acme",
                "name": "Acme Corp"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "orgId",
                    "name",
                    "dbName",
                    "apiKey"
                  ],
                  "properties": {
                    "orgId": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "dbName": {
                      "type": "string"
                    },
                    "apiKey": {
                      "type": "string",
                      "description": "Give this to the organization. It is not shown again."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "`orgId` or `name` is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "name must be 1-200 characters"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong admin token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid admin token"
                }
              }
            }
          },
          "404": {
            "description": "Admin routes are disabled (no admin token configured).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "not found"
                }
              }
            }
          },
          "409": {
            "description": "The orgId, or its database name, is already taken.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "an org with this id or database already exists"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "Meta"
        ],
        "operationId": "getOpenApi",
        "summary": "This API description (OpenAPI 3.1)",
        "security": [],
        "responses": {
          "200": {
            "description": "The OpenAPI document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/docs": {
      "get": {
        "tags": [
          "Meta"
        ],
        "operationId": "getDocs",
        "summary": "Interactive API docs (Swagger UI)",
        "security": [],
        "responses": {
          "200": {
            "description": "An HTML page.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "adminToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "The backend's BUGBUSTER_ADMIN_TOKEN. Only for admin routes."
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Your organization's API key."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Issue": {
        "description": "One folded error. `fidelity.isExact` is false when sampling was applied, i.e. `count` is a weighted estimate rather than an exact count.",
        "allOf": [
          {
            "type": "object",
            "properties": {
              "fingerprint": {
                "type": "string",
                "minLength": 1
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "usersAffected": {
                "type": "integer",
                "minimum": 0
              },
              "duration": {
                "type": "object",
                "properties": {
                  "p50": {
                    "type": "number",
                    "minimum": 0
                  },
                  "p95": {
                    "type": "number",
                    "minimum": 0
                  },
                  "p99": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "p50",
                  "p95",
                  "p99"
                ],
                "additionalProperties": false
              },
              "topEndpoints": {
                "type": "object",
                "properties": {
                  "top": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "endpoint": {
                          "type": "string",
                          "minLength": 1
                        },
                        "count": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "endpoint",
                        "count"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "other": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "top",
                  "other"
                ],
                "additionalProperties": false
              },
              "releases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "firstSeen": {
                "type": "string",
                "format": "date-time"
              },
              "lastSeen": {
                "type": "string",
                "format": "date-time"
              },
              "exemplarRefs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "eventId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "first",
                        "last",
                        "slowest",
                        "one-per-release",
                        "one-novel-stack"
                      ]
                    }
                  },
                  "required": [
                    "eventId",
                    "role"
                  ],
                  "additionalProperties": false
                }
              },
              "adjustedCount": {
                "type": "number",
                "exclusiveMinimum": 0,
                "default": 1
              }
            },
            "required": [
              "fingerprint",
              "count",
              "usersAffected",
              "duration",
              "topEndpoints",
              "releases",
              "firstSeen",
              "lastSeen",
              "exemplarRefs"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "fidelity"
            ],
            "properties": {
              "fidelity": {
                "type": "object",
                "required": [
                  "isExact",
                  "adjustedCount"
                ],
                "properties": {
                  "isExact": {
                    "type": "boolean"
                  },
                  "adjustedCount": {
                    "type": "number"
                  }
                }
              }
            }
          }
        ]
      },
      "Event": {
        "description": "One complete example event (exemplar) kept for an issue.",
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "exemplarRole": {
            "type": "string",
            "enum": [
              "first",
              "last",
              "slowest",
              "one-per-release",
              "one-novel-stack"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "type": "string",
            "enum": [
              "exception",
              "message",
              "span"
            ]
          },
          "trace": {
            "type": "object",
            "properties": {
              "traceId": {
                "type": "string",
                "minLength": 1
              },
              "spanId": {
                "type": "string",
                "minLength": 1
              },
              "parentSpanId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "traceId",
              "spanId"
            ],
            "additionalProperties": false
          },
          "service": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "environment": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "version",
              "environment"
            ],
            "additionalProperties": false
          },
          "source": {
            "type": "object",
            "properties": {
              "function": {
                "type": "string",
                "minLength": 1
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "function",
              "file",
              "line"
            ],
            "additionalProperties": false
          },
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "code": {
                "type": "string"
              },
